#----calories----
#api call for get all calories
###
GET http://127.0.0.1:8000/calories/
Accept: application/json
Authorization: Token 0b7855d764f243e6df882ff49944642b1f2c0457






#api call for adding calories
###
POST http://127.0.0.1:8000/calories/add/
Content-Type: application/json
Authorization: Token 0b7855d764f243e6df882ff49944642b1f2c0457

{
  "title":"porotta",
  "serving_size":"3",
  "calorie":800,
  "meal_type":"dinner"

}





#api call for get calorie
###
GET http://127.0.0.1:8000/calories/1/
Accept: application/json
Authorization: Token 0b7855d764f243e6df882ff49944642b1f2c0457






#api call for updating calorie
###
PUT http://127.0.0.1:8000/calories/5/
Content-Type: application/json
Authorization: Token 0b7855d764f243e6df882ff49944642b1f2c0457

{
  "id": 5,
  "title": "chicken biriyani",
  "serving_size": "1 plate",
  "calorie": 700,
  "meal_type": "lunch",
  "food_image": null,
  "created_at": "2026-11-16T12:18:22.584239Z",
  "owner": 2
}






#api call for delete calorie
###
DELETE  http://127.0.0.1:8000/calories/4/
Authorization: Basic raman:raman@123






#api call for get calorie summary
###
GET http://127.0.0.1:8000/calories/summary/
Accept: application/json
Authorization: Token 0b7855d764f243e6df882ff49944642b1f2c0457